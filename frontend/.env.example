# ==========================================
# HIREHUB FRONTEND CONFIGURATION (.env.example)
# ==========================================

# Backend API Base URL (leave empty in local development to use Vite proxy at /api)
# In production (e.g. Vercel, Netlify), set to your deployed backend API URL (e.g. https://api.hirehub.com)
VITE_API_URL=

# Google OAuth 2.0 Client ID (optional, for Google Sign-In)
# Generate in Google Cloud Console -> APIs & Services -> Credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
