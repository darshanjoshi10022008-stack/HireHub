# ==========================================
# HIREHUB BACKEND CONFIGURATION (.env.example)
# ==========================================

# Server Port
PORT=5000

# MongoDB Atlas Connection URI
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hirehub?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Frontend Base URL (used for CORS and verification/reset links)
FRONTEND_URL=http://localhost:5173

# Email Service Configuration (Nodemailer / Gmail SMTP)
# When omitted in development, links are safely logged to the server console.
# For live delivery with Gmail, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
# Note: EMAIL_PASS is also supported for backwards compatibility:
# EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=HireHub <no-reply@hirehub.com>

# Google OAuth Client ID (optional, for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
